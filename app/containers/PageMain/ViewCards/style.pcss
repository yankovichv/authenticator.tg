.cards {
  height: 100%;

  /* Search sits outside the scrolling area entirely: inside it, the
     scrollbar ran the full height and passed underneath the field, and
     pulling the list down carried the field away with it. */
  &_search {
    flex: 0 0 auto;
    box-sizing: border-box;
    padding: 12px 16px;
    background-color: var(--color-background-100);
  }

  &_scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  &_empty {
    box-sizing: border-box;
    padding: 24px 16px;
  }

  /* The card held under the finger: opaque, lifted off the list. */
  &_flying {
    opacity: 1;
    border-radius: 12px;
    background-color: var(--color-background-100);
    box-shadow: 0 8px 24px var(--color-fixed-black-010);

    &:after {
      display: none;
    }
  }

  /* The gap the card will drop into, travelling with the drag. */
  &_ghost {
    opacity: 1;
    border-radius: 12px;
    background-color: var(--color-foreground-005);

    &:after {
      display: none;
    }

    & > * {
      opacity: 0;
    }
  }

  /* While dragging, the pointer sweeps across the cards it passes over and
     every one of them lights up as if hovered. The dragged copy and the
     placeholder keep their own backgrounds. */
  &_dragging {
    & > *:hover:not(.cards_flying):not(.cards_ghost) {
      background-color: transparent;
    }
  }
}
