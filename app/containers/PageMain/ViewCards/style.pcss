/* The list scrolls inside itself rather than with the page. A sticky child
   only sticks within its own parent, and with the page scrolling the parent
   is one screen tall — the search field would ride away after the first
   screenful. */
.cards {
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;

  /* Stays put while the list scrolls: search is what you reach for after
     scrolling failed to find the account, and by then the field would be
     far above the screen. */
  &_search {
    top: 0;
    z-index: 2;
    position: sticky;
    box-sizing: border-box;
    padding: 12px 16px;
    background-color: var(--color-background-100);
  }

  &_empty {
    box-sizing: border-box;
    padding: 24px 16px;
  }

  /* The card held under the finger: opaque, lifted off the list. */
  &_flying {
    opacity: 1;
    border-radius: 12px;
    background-color: var(--color-background-100);
    box-shadow: 0 8px 24px var(--color-fixed-black-010);

    &:after {
      display: none;
    }
  }

  /* The gap the card will drop into, travelling with the drag. */
  &_ghost {
    opacity: 1;
    border-radius: 12px;
    background-color: var(--color-foreground-005);

    &:after {
      display: none;
    }

    & > * {
      opacity: 0;
    }
  }

  /* While dragging, the pointer sweeps across the cards it passes over and
     every one of them lights up as if hovered. The dragged copy and the
     placeholder keep their own backgrounds. */
  &_dragging {
    & > *:hover:not(.cards_flying):not(.cards_ghost) {
      background-color: transparent;
    }
  }
}
